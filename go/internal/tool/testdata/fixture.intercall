type user_id uint64;

type name string;

type point record {
    x float64;
    y float64;
};

type pixel record {
    red uint8;
    green uint8;
    blue uint8;
};

type empty record {};

type names list string;

type matrix list list int32;

type blob bytes;

type customer_id user_id;

exception denied;

exception failed record {
    code int32;
    message string;
};

exception overloaded names;

procedure echo {
    value string;
} string;

procedure add {
    a int8;
    b int16;
    c int32;
    d int64;
    e uint8;
    f uint16;
    g uint32;
    h uint64;
} int64;

procedure measure {
    x float32;
    y float64;
} float64;

procedure sample {
    data bytes;
    channel uint8;
} bytes;

procedure scale {
    factor float64;
    point point;
} point;

procedure render {
    pixels list pixel;
    depth uint16;
} list pixel;

procedure find {
    prefix string;
    tags list name;
} names;

procedure transform {
    rows matrix;
} matrix;

procedure join {
    parts list string;
    sep string;
} string;

procedure paint {
    origin record {
        x int32;
        y int32;
    };
    color record {
        red uint8;
        green uint8;
        blue uint8;
        alpha uint8;
    };
} record {
    width uint32;
    height uint32;
};

procedure locate {
    box record {
        corner record {
            x int32;
            y int32;
        };
        label string;
    };
} record {
    corner point;
    area uint64;
};

procedure grid {
    rows list record {
        row uint16;
        col uint16;
        value int64;
    };
} uint64;

procedure wave {
    samples list uint8;
} uint32;

procedure ping {};

procedure notify {
    message string;
};

procedure stamp {} record {};

procedure blanks {
    count uint64;
} list empty;

procedure tiny {
    mark empty;
    note record {
        tag empty;
        code uint32;
    };
} empty;
