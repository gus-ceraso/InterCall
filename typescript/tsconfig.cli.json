{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": [
    "src/cli/**/*.ts",
    "src/syntax/**/*.ts",
    "src/tool/**/*.ts",
    "src/runtime/**/*.ts",
    "src/generated-spi/**/*.ts"
  ]
}
